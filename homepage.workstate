      - meta_descriptions
      - author_metadata
      - canonical_links
      - Open_Graph_metadata
      - root_relative_stylesheet_paths
      - project_relative_stylesheet_paths
    remaining_seo_tasks:
      - [add_or_update_sitemap.xml](https://add_or_update_sitemap.xml)
      - [add_sitemap_reference_to_robots.txt](https://add_sitemap_reference_to_robots.txt)
      - verify_all_navigation_links
      - verify_all_project_urls
      - optionally_add_JSON_LD_to_resume
      - optionally_add_project_schema
      - test_mobile_layout
      - test_social_previews
      - upload_final_structure_to_Neocities

  robots:
    file: [robots.txt](https://robots.txt)
    current_policy:
      normal_search_engines: allowed
      listed_ai_crawlers: disallowed
    required_addition:
      - "Sitemap: [https://psycedelicai.neocities.org/sitemap.xml](https://psycedelicai.neocities.org/sitemap.xml)"

  hosting:
    provider: Neocities
    public_url: "https://psycedelicai.neocities.org/"
    local_preview: "file:///home/psycedelic/Documents/Homepage/"
    upload_status: pending_final_structure
    required_uploads:
      - root_HTML_files
      - core_directory
      - projects_directory
      - [robots.txt](https://robots.txt)
      - [sitemap.xml](https://sitemap.xml)

  file_paths:
