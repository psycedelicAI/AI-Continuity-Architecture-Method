  contact_page:
    purpose: public_contact
    primary_method:
      type: email
      address: "[psycedelic.ai@guardkc35m.8shield.net](mailto:psycedelic.ai@guardkc35m.8shield.net)"
    secondary_method:
      type: onionshare_receive_files
      url: "http://ln5nhajofhqvyeo7sjntwbfiwvbythmjvocxp2hec7btty5v57yrxaqd.onion"
    contact_strategy:
      primary: normal_email
      optional_private_method: onionshare
    note: >
      OnionShare remains available as an optional Tor-based contact method,
      while email is the normal public contact route.

  projects_page:
    purpose: project_ecosystem_entry_point
    url: "https://psycedelicai.neocities.org/projects/"
    categories:
      professional_work:
        - AI Continuity Architecture Method
        - High-Security Facility Concept
        - Knowledge Architecture
        - GitHub Onboarding System
      independent_concepts:
        - SkolAI
        - Digital Voting with BankID
      human_ai_collaboration:
        - Symbiosis
        - Livedemo and working methods
      experiments_and_archive:
        - Experiments
        - Documentation
        - Random-Stuffs
        - Psycedelic Archives

  project_pages:
    ai_continuity:
      status: methodological_experimental_public
      focus:
        - context preservation
        - Memory Bank
        - Portable Workstate
        - context reconstruction
        - human authority
        - AI continuity

    symbiosis:
      status: conceptual_methodological_public
      focus:
        - human_ai_collaboration
        - human meaning
        - AI analysis
        - shared development
        - responsibility
        - boundaries

    architecture:
      status: conceptual_architectural_experimental
      focus:
        - systems architecture
        - authority
        - permissions
        - boundaries
        - recovery
        - governance
        - human oversight

    security:
      status: conceptual_experimental_public
      focus:
        - protected environments
        - controlled access
        - least privilege
        - security zones
        - oversight
        - recovery
        - resilience

    experiments:
      status: experimental_open_ended
      focus:
        - prototypes
        - AI tests
        - prompts
        - creative projects
        - unfinished ideas
        - Random-Stuffs
        - archives

    documentation:
      status: active_maintained_public
      focus:
        - onboarding
        - project maps
        - shared vocabulary
        - project status
        - public technical communication
        - knowledge organisation

    knowledge_architecture:
      status: active_maintained_public
      focus:
        - repository organisation
        - project relationships
        - documentation structure
        - public_private boundaries
        - onboarding
        - status models

    skolai:
      status: conceptual_proposed_not_validated
      focus:
        - AI in education
        - AI thinking partner
        - student agency
        - teacher control
        - privacy by design
        - project workstate
        - temporary local continuity
      principle: >
        AI should not think for children. AI should help children think further.
      source: "https://github.com/psycedelicAI/wiki/tree/main/SkolAI"

    digital_voting:
      status: conceptual_proposed_experimental_not_validated
      focus:
        - BankID eligibility verification
        - identity separation
        - anonymous QR tokens
        - polling station tablets
        - ballot secrecy
        - fallback procedures
        - accessibility
        - digital election architecture
      central_principle: >
        BankID may verify voting eligibility, but must never be connectable to
        the vote itself.
      source: "https://github.com/psycedelicAI/wiki/blob/main/Digitalt-Valsystem-BankID.md"

  github_ecosystem:
    organisation: "https://github.com/psycedelicAI"
    repositories_and_areas:
      - name: psycedelicAI
        role: organisation_entry_point_and_onboarding
      - name: wiki
        role: central_documentation_and_knowledge_architecture
      - name: AI-Continuity-Architecture-Method
        role: continuity_methodology
      - name: high-security-facility-concept
        role: trust_and_security_architecture
      - name: Symbiosis
        role: human_ai_collaboration_and_philosophical_work
      - name: Random-Stuffs
        role: experiments_archive_and_older_material
    documentation_layers:
