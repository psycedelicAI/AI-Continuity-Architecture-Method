workstate:
  id: psycedelicai-homepage-development
  version: "1.0.0"
  status: active
  type: public-website-development-workstate
  created: "2026-09-16"
  language:
    conversation: Swedish
    website: English
  human_owner: Psycedelic
  human_name: Kalle Pettersson
  project_identity: PsycedelicAI
  public_url: "https://psycedelicai.neocities.org/"

  purpose: >
    Preserve the current development state of the PsycedelicAI public homepage,
    including its structure, content direction, project organisation, SEO work,
    and remaining tasks.

  core_status:
    homepage_core: complete
    visual_identity: complete
    root_navigation: established
    project_navigation: established
    project_pages: created
    resume_page: created
    contact_page: created
    public_email_contact: active
    onionshare_contact: retained_as_optional
    seo_work: in_progress
    final_live_upload: pending

  design_direction:
    identity:
      primary_name: PsycedelicAI
      human_identity: Psycedelic
      professional_identity:
        - IT Technician
        - System Administrator
        - IT Infrastructure
        - Systems Thinker
        - Concept Designer

    visual_style:
      theme: dark futuristic professional
      background: dark navy with purple and teal gradients
      accent_colors:
        purple: "#a371f7"
        light_purple: "#bc8cff"
        teal: "#39d0c8"
        green: "#56d364"
      style_keywords:
        - professional
        - experimental
        - human_ai_collaboration
        - systems_thinking
        - livedemo_flavor
        - public_workstate
        - readable
        - connected
      interaction:
        - clickable project cards
        - hover states
        - responsive layouts
        - visible project status
        - no unwanted link underlines

  website_structure:
    root_files:
      - [index.html](https://index.html)
      - [home.html](https://home.html)
      - [about.html](https://about.html)
      - [resume.html](https://resume.html)
      - [contact.html](https://contact.html)
      - [other.html](https://other.html)
      - [robots.txt](https://robots.txt)

    core_directory:
      path: core/
      subdirectories:
        css:
          files:
            - [style.css](https://style.css)
        java:
          purpose: future JavaScript files
        json:
          purpose: future structured data files
        assets:
          purpose: images, icons, and other static assets

    projects_directory:
      path: projects/
      files:
        - [index.html](https://index.html)
        - [ai-continuity.html](https://ai-continuity.html)
        - [symbiosis.html](https://symbiosis.html)
        - [architecture.html](https://architecture.html)
        - [security.html](https://security.html)
        - [experiments.html](https://experiments.html)
        - [documentation.html](https://documentation.html)
        - [skolai.html](https://skolai.html)
        - [digital-voting.html](https://digital-voting.html)
        - [knowledge-architecture.html](https://knowledge-architecture.html)

  navigation:
    root_pages:
      home: "home.html"
      about: "about.html"
      resume: "resume.html"
      projects: "projects/index.html"
      contact: "contact.html"
      other: "other.html"

    root_navigation_label:
      - Home
      - About
      - Resume
      - Projects
      - Contact
      - Other

    project_page_navigation:
      home: "../home.html"
      about: "../about.html"
      resume: "../resume.html"
      projects: "index.html"
      contact: "../contact.html"
      other: "../other.html"

  homepage:
    index:
      purpose: public_entry_point
      title: "PsycedelicAI"
      subtitle: "Human perspective. AI perspective. Shared development."
      role: >
        Introduces PsycedelicAI as a public workstate and directs visitors
        toward the homepage, resume, projects, contact page, and other links.
      seo:
        canonical: "https://psycedelicai.neocities.org/"
        focus:
          - PsycedelicAI
          - Kalle Pettersson
          - human_ai_collaboration
          - systems_thinking
          - AI_continuity
          - security_architecture
          - technical_documentation

    home:
      purpose: main_public_homepage
      title: "Ideas becoming systems."
      content:
        - What PsycedelicAI is
        - Professional work
        - AI continuity
        - Symbiosis
        - Architecture
        - Security concepts
        - Experiments
        - Documentation
        - SkolAI
        - Digital voting
        - Knowledge architecture
        - Current workstate
        - Contact call_to_action
      livedemo_flavor:
        - live_workstate
        - active_status
        - continuity_status
        - experimental_status
        - human_first_language
      project_links:
