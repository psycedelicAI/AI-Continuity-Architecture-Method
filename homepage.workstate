    project_css_path: "../core/css/style.css"
    root_project_link: "projects/index.html"
    project_index_link_from_project_page: "index.html"
    project_to_root_link: "../home.html"
    javascript_root_path: "core/java/script.js"
    javascript_project_path: "../core/java/script.js"
    json_root_path: "core/json/data.json"
    json_project_path: "../core/json/data.json"

  current_task:
    name: homepage_and_public_ecosystem
    phase: SEO_and_final
