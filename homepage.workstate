        symbiosis: "projects/symbiosis.html"
        architecture: "projects/architecture.html"
        security: "projects/security.html"
        experiments: "projects/experiments.html"
        documentation: "projects/documentation.html"
        skolai: "projects/skolai.html"
        digital_voting: "projects/digital-voting.html"
        knowledge_architecture: "projects/knowledge-architecture.html"

  about_page:
